# GigShield Backend Environment Configuration
# Copy this file to .env and fill in your keys

# OpenAI API Key (required for AI agents)
OPENAI_API_KEY=sk-your-openai-key-here

# OpenWeatherMap API Key (free tier available at openweathermap.org)
WEATHER_API_KEY=your-openweathermap-key-here

# AQICN API Key (free at aqicn.org/api/)
AQI_API_KEY=your-aqicn-key-here

# Database (SQLite by default; replace with PostgreSQL URL for production)
DATABASE_URL=sqlite+aiosqlite:///./gigshield.db

# App Settings
APP_ENV=development
SECRET_KEY=gigshield-super-secret-key-change-in-production

# Trigger Thresholds
RAIN_THRESHOLD_MM=10.0
AQI_THRESHOLD=200
HEAT_THRESHOLD_C=40.0

# Monitoring Interval (seconds)
MONITOR_INTERVAL_SECONDS=60
